				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Sessions connect runtime activity back to the identity context that caused it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
