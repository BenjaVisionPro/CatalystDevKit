					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "t0+awUoAQSeZcMi7XmZpgg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Sessions connect runtime activity back to identity context without pretending to define social presence."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "G4RI2veWT9WyckCGCvtidg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Sessions"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "52g8B9AiRSy6zrT32MwrWw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Sessions give Catalyst People a modest, useful bridge between identity and runtime activity. They tell other components which person, persona, account, device, principal, or endpoint is involved in an interaction."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "IrW/68MNTmSYjxRC4s2lQw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Sessions"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "+gTn93fVSkWKjuedDRDoYg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A session is a runtime connection or authenticated interaction. It may represent a person using a tool, a persona entering a game, a service operating on behalf of an account, or a device connected to a deployment."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "0rYtRsAOQJGgoLgN1Xz66A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Sessions are identity context. They are not social presence. People does not decide whether someone is online, busy, visible, hidden, in a lobby, or available for voice. Those meanings belong to the endpoint, application, or Catalyst Connect."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "vO6Lv74ORCq8NMX0D37kFg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "GNwpMvpBQhqYgtci8hrQIA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives components a safe way to connect runtime actions back to the identity context involved."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "y+B8SLOsRoi7t2DDRzd6mw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It keeps Person separate from the current connection. A person is still a person when no session exists."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "pLcc7Fo0Tf+vAJQSnSuOIw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It avoids turning endpoint-specific state into a fake universal model. If an endpoint wants availability, visibility, activity, or social state, it can define those meanings in its own context."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "wAQgE+HjTP+vFxNhaiGNJg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "KcaVZx/4QripEUxluW+JcA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A session records the context of an interaction: the deployment, endpoint, principal, persona, account, device, and person involved where those are known and appropriate."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "WmN9++WJR1y4JRl/77RqMg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Other systems can use session context without inheriting a global status model. Catalyst Connect can use sessions as one input to richer presence systems, but presence itself belongs with Connect and the experience it creates."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "tXIiRS0oSASDfLWR0o8s1g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Commands / configuration / examples"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
