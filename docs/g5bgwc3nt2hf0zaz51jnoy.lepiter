				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence and Sessions explains how People connects human identity to runtime activity without confusing sessions for people."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
