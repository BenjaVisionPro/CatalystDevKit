				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Sessions are created in a context such as a deployment, game, tool, or service. Presence is derived from sessions, preferences, privacy, and application rules."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
