					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "0LZD4N8JtXKJljuPSginew=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence can also be exposed through Catalyst Connect so communication systems know which endpoints or channels are available."
			},
