				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "97JpfNGoRmiymJESI1p+5A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Do not use Sessions as a dumping ground for social state. Keep the session factual, and let endpoints or Connect define what that state means to people using the system."
			}
		]
