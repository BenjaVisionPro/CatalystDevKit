				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A session references the relevant Person, Persona, Account, Principal, Device, Endpoint, and deployment context where those concepts apply. Applications and endpoints can add their own session-specific meaning on top."
			},
