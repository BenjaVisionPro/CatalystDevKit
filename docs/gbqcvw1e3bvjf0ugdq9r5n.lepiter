				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "WmwI7l88tJuT9ac2PXh3Ig=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect exists because realtime distributed systems need communication that is purpose-built, observable, and ruthless about relevance."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "x2pnQw31ORYkpM+EuoazQw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Why Catalyst Connect"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "eTT/2Zkx0QMLXA8LdrHM4A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect is the communication component behind Catalyst systems that need to coordinate players, simulations, tools, and services without pretending generic transports solve every realtime problem."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "GVPbM8I4I7wqq5/czAEwyQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "iPBuzwZgKrjTE7F1KGyMug=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Realtime systems lose quality when stale messages keep travelling after they are no longer useful."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "5RhQS92tMTyei1ua+DIHGw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Generic transports usually give you bytes, streams, or packets. Catalyst Connect adds a model for relevance, delivery intent, observability, and operational control."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "lXnxbijxiB2YY9/QiOrP9Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives Catalyst projects a shared language for connection design instead of each project inventing a private networking stack."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "WRqovP2ndcj5lrygBxZu4Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "zeFFMvyvwtc1P24F5VTz7A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect separates the communication problem into slices: sockets, transport, codec, router, and endpoints. Each slice owns one job and exposes clear responsibilities to the next layer."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "TRTq9l44aRYwRcH9wUdqmg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "BVCC is the toolkit. BVCP is the default protocol design that demonstrates the toolkit: message relevance windows, mixed reliability, and telemetry from day one."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
