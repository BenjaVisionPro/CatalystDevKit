				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Why Catalyst Connect"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
