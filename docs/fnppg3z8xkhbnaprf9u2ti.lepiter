				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Routes match by type id, version range, optional predicate, peer constraints, and QoS policy. Multiple routes can match, so fan-out is explicit. Failed policy or admission checks drop or redirect messages with telemetry."
			},
