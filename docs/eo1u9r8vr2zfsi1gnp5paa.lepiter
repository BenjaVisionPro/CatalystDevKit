				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Plugins are adapters for external systems such as Unreal Engine, Voxel Plugin Pro, editors, runtimes, or third-party services."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
