				},
				"uid": {
					"__type": "uid",
					"uidString": "hir5+5DBdcAAxrgRdH+bcQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "An invitation proposes a relationship or relationship change. Accepting it creates, activates, or updates the target relationship. Rejecting, revoking, or expiring it leaves an audit trail without creating the active membership."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "GKo/iwM8QRplPPnqy3eLxw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The resulting membership relationship can then carry roles, status, responsibility, visibility, and other temporal aspects."
			},
