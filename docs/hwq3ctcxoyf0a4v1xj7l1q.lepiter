				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Invitations give groups a clear way to propose membership or collaboration without pretending the relationship already exists."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
