				"uid": {
					"__type": "uid",
					"uidString": "Qo8EcbyLXUIhcffl4yFEfA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Invitations"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "qES6JCSSSHcbmbdukEpUEg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "An invitation is an offer or request to create or change a relationship. In Groups, the common case is inviting a person or persona to become a member of a group."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "atPW2CuuYsUIVU9EjKGqAw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Invitations are process objects. They are not roles. They can lead to a relationship that has roles, status, and history, but the invitation itself is the workflow that gets there."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
