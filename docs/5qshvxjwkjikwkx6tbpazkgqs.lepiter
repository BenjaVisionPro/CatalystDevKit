					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-10-17T03:55:32.499Z"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "MoMlx11P7cpzYbekg6hJZA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Documentation authority\nShared principles live on Catalyst working rules. Each framework owns its detailed contracts, implementation map, examples and gaps beside its source. Runtime's book is registered separately from the DevKit book. Keep historical reviews and baselines explicitly historical; do not silently treat a document titled current as current evidence. Existing Word and Markdown material remains in place for this P0 increment. Follow the Runtime book for its current entry point."
			}
		]
	},
