				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "1Ph3O+dpRxyzZE1D7KMjNg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "CRRuntime>>applyConfiguration: stores the applied configuration, builds the effective configuration, validates it, increments the version, then activates and distributes it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "m7eQsHTFQaeJvilSc5xKxg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Validation has one path: Magritte schema validation, semantic validation, then runtime graph validation."
			},
