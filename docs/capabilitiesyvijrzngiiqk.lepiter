				"uid": {
					"__type": "uid",
					"uidString": "qG/D3kErTDGRuiKFfHF+gA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A capability is an API object granting a specific kind of runtime authority, such as scheduling, orchestration, statistics, runtime control, or query access."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
