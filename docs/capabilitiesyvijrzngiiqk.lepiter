				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Capabilities are the runtime\u2019s authority surface. They make it clear what a service or work unit is allowed to do."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
