				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "RL2EXe9LR6q+Y1n+iJmsdg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Macos - Use Touch ID authentication on the terminal\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "KBsUCvf+SUyIQGCYzyPeXw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "If you're sick of typing your password when running ```sudo``` you can enable Touch ID instead.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "CnvP/nQmSuCywmDp1ONZzg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "```bash\nsudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local\nsudo nano /etc/pam.d/sudo_local\n```\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "wSFBos/GSnyuDuezz91+AQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "and follow the instructions inside, uncommenting the last line of the file by removing the # from the start of the line so the file looks like this:\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "7aQl84wLTmm4spxS9CVMMg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "```nano\n# uncomment following line to enable Touch ID for sudo\nauth       sufficient     pam_tid.so\n```\n"
			},
