				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Extras\n\nThis is retained project/scratchpad material. It is not part of the main DevKit documentation path.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
