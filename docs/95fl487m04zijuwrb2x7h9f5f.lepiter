				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-10-17T08:48:37.691861+11:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-10-17T08:48:37.691861+11:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "rI6K85KhRLad72jpZx2opQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "For ordinary delegation, omit toolNames or supply an empty list so the role supplies its tools. If narrowing is needed, supply a nonempty subset of the available role tools. A failed child returns its actual error and agentExecutionId, and the result's Agent chat view retains the child for inspection. Report the error and reference the child instead of describing every failure as a missing response."
			}
		]
