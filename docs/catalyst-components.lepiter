				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Catalyst Components\n\nCatalyst Components are first-party capabilities built for Catalyst projects.\n\nThey are not external integrations. They are pieces of the Catalyst platform that can be used, combined, documented, and extended as the project grows.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
