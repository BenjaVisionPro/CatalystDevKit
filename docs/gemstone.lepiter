					"uidString": "auwJqROqRcqOKX4UGABDsw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# GemStone\n\nGemStone is the object database and Smalltalk runtime underneath Catalyst deployments.\n\nbvc hides the normal setup and lifecycle work so developers can focus on their project.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Pe42eYrCR32qGfTBrmGBew=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What bvc owns\n\nbvc uses GsDevKit_stones to create, start, stop, delete, and list deployments.\n\nYou usually do not need to call GsDevKit commands directly.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "tjb0OV94RteNhUY+Gj+z5Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## When to care\n\nYou should care about GemStone details when you are:\n\n- debugging deployment startup\n- checking registered stones\n- investigating a failed install\n- tuning server behaviour\n- working directly with GemStone tooling\n\nOtherwise, use the bvc commands.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "rbhWUusvT76uzj2mNakTkA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Useful checks\n\n```sh\nregistryReport.solo --registry=bvc\n```\n\nShows the configured registry.\n\n```sh\ngslist.solo -lc\n```\n\nShows running stones.\n\n```sh\nbvc list\n```\n\nShows the same information through the Catalyst command line.\n"
			}
		]
	},
