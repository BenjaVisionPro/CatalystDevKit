				"uid": {
					"__type": "uid",
					"uidString": "US7ZNSGQxPCkrBdAgZJZGQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The endpoint slice is where application code attaches handlers, sends messages, opens streams, and supplies QoS hints without touching sockets, frames, or routing internals."
			},
