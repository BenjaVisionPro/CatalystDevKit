				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Workers are the execution boundary inside the fabric. They may run on hosts or in-image for development, but their role is the same: accept work, execute it, and publish evidence."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
