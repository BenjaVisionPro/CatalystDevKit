				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A worker drains routed work, resolves required capabilities, builds CRWorkUnitExecutionContext, and executes the enclosed work unit. The worker boundary catches failures and writes failure evidence to handles."
			},
