				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect is the Catalyst communication component for realtime, observable, purpose-fit distributed systems."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "jduKS2AqZJ1Sh+1ypMW5wA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Catalyst Connect"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "hqiszmjv+ipTAIiUmcSuGA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect gives Catalyst projects a practical communication foundation for realtime systems: explicit connection boundaries, protocol slices, message relevance, and telemetry from the start."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "7CRoLAXs6UspK34c7j4Jzw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Catalyst Connect"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Wo0uCe7c/wA7DcK+aw0b/g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Connect is a first-party Catalyst Component for building distributed message systems. It includes the BVCC toolkit model and BVCP, the default protocol design shaped by the PF4P principle: Perfectly Fit Four Purpose."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "HiH3aLsO5ZvdzyYr7p6Lzw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "RwhamPSsW6JdRat4y/DMng=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives projects a clear way to handle communication when generic transports are close but not precise enough for realtime simulation, multiplayer, live tools, or distributed services."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "w5wyrwY7P/J+aOo+V+JtcQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It makes relevance, delivery intent, routing policy, and observability explicit instead of burying them inside custom networking code."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "SeqNrAsFfBGkastOVmmiEA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:10:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "u4Ben0yqS3+1IFgrvDUlmQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Connect is organised into slices. Sockets own lifecycle and readiness. Transport owns frames, pacing, reliability, and reassembly. Codec owns message format. Router owns delivery policy. Endpoints expose the application boundary. Presence describes the shared communication experience Connect can help create across people, audiences, and environments."
			},
