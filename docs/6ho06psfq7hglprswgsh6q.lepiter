					"uidString": "VbAFfqakJcrfcQNhug9irA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Connect Architecture"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "mJGfK7DUZONFks3ZnjiXoQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The architecture splits communication into sockets, transport, codec, router, and endpoints. This keeps platform details, framing, encoding, routing, and application APIs separate."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "repldnF2Htl0NvDcKrOe7w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "DVdkBIrjUCYeesRb7vN6Kg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It prevents socket code from accidentally becoming transport logic."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "fpZue1RzbTRVpNrVClCUWw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It prevents codecs from owning routing policy."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
