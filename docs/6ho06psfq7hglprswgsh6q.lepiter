				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "69qcULY+P2FylPx9FJstvQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Slice 1 owns socket lifecycle and readiness signals. Slice 2 owns transport framing, pacing, reliability, and reassembly. Slice 3 owns message encoding and decoding. Slice 4 owns routing decisions. Slice 5 owns endpoint-facing APIs."
			},
