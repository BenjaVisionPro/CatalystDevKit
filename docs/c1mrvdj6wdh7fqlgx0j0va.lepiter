				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Components give projects shared vocabulary and common foundations."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
