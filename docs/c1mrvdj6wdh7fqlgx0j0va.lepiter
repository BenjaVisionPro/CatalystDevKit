					"uidString": "kFMwDe98YjsPaRfrV/gEcA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Components are first-party building blocks for identity, communication, storage, currency, worlds, tooling, and simulation."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "dAUGtd1XJhnyygMb2WEQXw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Catalyst Components"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "4MHQjmu5DB9Mtrj16H6n6w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst Components are reusable capabilities that belong to the Catalyst platform. They are designed to give projects solid foundations without forcing every application to rebuild the same machinery."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "5YlRotKtVJb2AXD6flRBbg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Catalyst Components"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "fgcdVWwc1WBVA3yePtRkeQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A component is a first-party Catalyst capability. Components can provide domain models, services, tools, storage patterns, communication layers, or runtime support."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "5Twx54mO5ed2JrNoOVwNaQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Plugins are different. Plugins connect Catalyst to external systems such as Unreal Engine or another runtime. Components are part of Catalyst itself."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "FwUL64TBZ6haoGPMGX68Lw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "PNNSnsqyY1vpomnMNupc/g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Components keep common application foundations consistent. People, groups, connect, store, currency, landform, reflect, architect, and ecosystems should feel like parts of one platform rather than unrelated packages."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "kkLBY7UObNlphuKreOL7Zg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "They also give each concern a clear home. People owns humans, personas, roles, and relationships. Groups owns collective identity and invitations. Connect owns communication. Store owns durable product and ownership models."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "iItTRYmKUGi1nL29OyGGxg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "icjb/yv5ODt12KpasteVrA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Each component gets an overview page and deeper example pages as the implementation matures."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "K5gntOVcaTf0g9fSnJCPyA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The overview pages are intentionally short. They should help a developer decide whether the component is relevant, then point them to examples and implementation docs."
			},
