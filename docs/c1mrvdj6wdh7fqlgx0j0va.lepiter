				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Read {{gtPage:Catalyst People|db=731asfxqhyhdr96k6wo9yxnzv}} for human identity and relationships, {{gtPage:Catalyst Groups|db=731asfxqhyhdr96k6wo9yxnzv}} for collective identity, and {{gtPage:Catalyst Connect|db=731asfxqhyhdr96k6wo9yxnzv}} for communication."
			},
