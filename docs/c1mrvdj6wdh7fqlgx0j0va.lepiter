					"uidString": "7jfeWg3pTWwErn4BUg/K6Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "They reduce the number of times every project has to rebuild identity, groups, communication, stores, currency, landform, reflection, architecture, and simulation support from scratch."
			},
