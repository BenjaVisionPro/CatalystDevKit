				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Relationship Aspects is the core pattern for modelling values that change over time without forcing every change into one large phase record."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "XAL7EuC5Mhv48ruV+LSpEQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Relationship Aspects"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "oQcPOSQf8sYAY4dWB1U3hQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "An aspect is one meaningful property of a relationship or one of its ends. Examples include role name, relationship type, status, strength, stress, trust, visibility, responsibility, and commitment."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "LW6Gtuw+1geH6tsnw5eMjA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Each aspect has its own history. That means trust can change weekly, role can change once, and visibility can change only when the relationship becomes public."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
