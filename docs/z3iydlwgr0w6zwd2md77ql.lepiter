				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Relationship Aspects is the core pattern for modelling changing relationship values without forcing every change into one large phase record."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
