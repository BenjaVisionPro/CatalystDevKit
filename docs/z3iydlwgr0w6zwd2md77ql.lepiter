				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "BXKQSNMWMkg0FZZeGqmA+w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "An aspect is one meaningful property of a relationship or one of its ends. Examples include relationship type, role name, status, strength, stress, trust, visibility, responsibility, and commitment."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "qNZ0+NmyUSc+37ik6/3rzA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Each aspect has its own history. Trust can change weekly, role can change twice in ten years, and visibility can change only when a relationship becomes public."
			},
