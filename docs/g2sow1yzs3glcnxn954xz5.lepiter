				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Security and pacing protect realtime communication from accidental overload and hostile traffic without hiding the trade-offs."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
