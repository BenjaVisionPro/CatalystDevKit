					"uidString": "eYKdhFHXyh0qmiuvFjA1JA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "IxCXg2TA4flp40q6m+h42A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Receivers enforce caps and timeouts during record reassembly. Senders pace traffic based on configured budgets and transport feedback. Security gates live at the appropriate layer: socket gates for connection readiness, transport gates for frame and record behaviour, router gates for message policy."
			},
