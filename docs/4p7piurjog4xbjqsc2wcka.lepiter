				},
				"uid": {
					"__type": "uid",
					"uidString": "2luFcgbCkiigNJXfANtqJg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Keep the language boring where it should be boring: Person means human. Persona means contextual identity. Account means contextual access or value container. Principal means actor in a runtime."
			}
		]
