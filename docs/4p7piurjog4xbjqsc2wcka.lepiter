				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst People starts with real humans, then layers contextual identity and runtime access around them."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
