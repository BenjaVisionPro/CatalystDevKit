				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst is a toolkit for building applications with a clear split between project setup, development tools, reusable components, and deployment runtimes."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
