					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "wbu/pnc3QpmlEP9q63xdqw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Retention uses bounded deterministic ring buffers that drop oldest first."
			},
