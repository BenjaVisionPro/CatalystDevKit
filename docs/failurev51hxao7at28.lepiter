				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "OzTyEP5KQbWUqJiqjpLAmA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Runtime failures should be inspectable after they happen. Failure evidence gives developers and tooling something durable to read."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "yjEywEvrRH2AOEPYdbWpGg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Failure Evidence"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "iIZcuPO3T/CRMU9RZ89WXQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A failed work unit produces a CRFailedWorkUnitExecution record. Records are written to the worker handle ring buffer and, when service-scoped, to the service handle ring buffer too."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
