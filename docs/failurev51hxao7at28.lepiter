				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It makes failure state durable and bounded."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "fXI+RsFXQmm1j9JatcV9zA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It separates tooling diagnostics from source-of-truth records."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
