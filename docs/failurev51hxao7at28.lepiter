				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The worker boundary catches failures and writes evidence. Announcements such as CRWorkUnitFailedAnnouncement can still inform tooling, but they are not the source of truth."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
