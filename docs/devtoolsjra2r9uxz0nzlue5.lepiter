					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "XhXqPEURRDe3NDvXKj7U4Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst separates the tools you use to develop a system from the deployments that run it, even when one tool also provides a development deployment mode."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Qcyf2BTjSgOFVNx867M1iw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Development Tools"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "weBnF3iFTSeMDTdre4gvOA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Development tools are project-local applications prepared by bvc. DevKit Development is the main Glamorous Toolkit workspace. Jadeite for Pharo is a focused GemStone development tool."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "L/hK4+IzTAya2YErJq0Wlg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Pf9g3OBaTsawBpTHcJX2iQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives developers a clear place to start. It keeps tool setup reproducible. It separates the daily development workflow from production deployment. It also makes the dual role of DevKit explicit: DevKit Development is the tool, while DevKit Deployment is the runtime running inside it."
			},
