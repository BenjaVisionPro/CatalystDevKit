				"uid": {
					"__type": "uid",
					"uidString": "sbFH61HZTQ+adumkccT96Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "bvc builds tools when needed and launches them from the project. Use DevKit Development for the main Catalyst workflow. Use Jadeite when you specifically want a GemStone-focused tool."
			},
