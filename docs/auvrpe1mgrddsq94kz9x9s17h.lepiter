				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "D6IyAbA/RX6eUYg4oT6wnQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "These pages are editable working instructions. Each new user message and each new child task takes a fresh instruction snapshot. Changes apply to subsequent work; they do not rewrite a task already running. Keep project knowledge in the existing Catalyst Lepiter database."
			},
			{
				"__type" : "textSnippet",
