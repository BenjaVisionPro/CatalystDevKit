				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "INQGeTvzThCCWA2Ode02+g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Deployments give Catalyst projects a real server runtime without making every developer become a GsDevKit expert first."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "fa9Bk1AgTuWbVU+j1CuHcQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Deployments"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "FX+HMWHgRAWqCEnVJ4rzvA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A deployment is a GemStone stone registered through GsDevKit_stones and managed through bvc."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "nvRr5FeiSQmiHfs7nbWCNQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Jb5zXpKETOKrPmnJ9PFNGg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives every project a named runtime. It keeps development and production-like state separate. It makes start, stop, list, and delete explicit. It keeps connector metadata in sync for the DevKit."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "TEnX7M/vRz2zqdIAZFHw+A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "QdaMaShiQJOpTgZBwk32+A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "`bvc start` checks whether a deployment exists. If it exists, bvc starts it. If it does not exist, bvc installs it first, then starts it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "tvkYQIyJSlyhqbZV6PIeZw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "When deployments are created or deleted, bvc refreshes the DevKit's `gt4gemstone.properties` connector file if the DevKit exists."
			},
