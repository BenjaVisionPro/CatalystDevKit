				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Deployments are the runtime environments managed by bvc, from local DevKit runtime work to production GemStone stones."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "//PXf3caSEesFZcoF+znrQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Deployments"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "OgXZMQhNQM+F/k4Q26TT7A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Deployments make the runtime model explicit. DevKit Deployment is for local development runtime work. GemStone is the production deployment runtime."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "0RmWKzWsRYih/RaSY0jneA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Deployments"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "ySBlls9pSh+f+sJSXTpNqw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A deployment is a named runtime environment. In development, the runtime can run standalone inside the DevKit. In production, the runtime runs in GemStone as a stone managed through bvc and GsDevKit_stones."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "3D34wmirTTC3eoMnzYpISA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "C0Zleb5PQ8mLdxAlc1Gtag=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It keeps development runtime work and production runtime work visually separate. It gives every runtime a clear name. It makes start, stop, list, and delete explicit. It keeps connector metadata in sync for development tools."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "joZkL4EQTnGRGK0G2vE8pQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "VdozytjWRTe341Yx0gGFwg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Use DevKit Deployment while shaping the system locally. Use GemStone when the runtime needs the production model: server authority, durable state, transactions, and long-lived object storage."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "dSFJQ7OZQWe0XIDYItdFmQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "For GemStone deployments, `bvc start` checks whether a deployment exists. If it exists, bvc starts it. If it does not exist, bvc installs it first, then starts it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
