				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Deployments are GemStone stones managed by bvc, giving each project a predictable runtime you can start, stop, list, and delete."
			},
			{
				"__type": "textSnippet",
				"children": {
