				},
				"uid": {
					"__type": "uid",
					"uidString": "XrUqwrcSgkFN1Wk0sbxIkQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Commands / configuration / examples"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
