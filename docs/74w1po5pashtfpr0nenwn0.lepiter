				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "tR87CslhjVAjLlq0KvevNg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Use PF4P as the lens for deciding whether BVCP is enough through configuration, or whether a project needs a custom Catalyst Connect transport."
			},
