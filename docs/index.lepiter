						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "V4VmtJSYR0yFXEsKl70IPQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Start here\n\n{{gtPage:Quick Start|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Core Commands|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Project Configuration|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Deployments|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:DevKit|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Jadeite for Pharo|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:GemStone|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Catalyst Components|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Catalyst Plugins|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Troubleshooting|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Reference|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n{{gtPage:Notes|db=bb9d96c9-9bd1-0d00-a109-c4d10ab7a977}}\n"
			},
			{
