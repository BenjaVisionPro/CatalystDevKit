				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# BenjaVision Catalyst DevKit\n\nCatalyst DevKit is the command line and development environment for building applications with Catalyst.\n\nThe goal is simple: create a project, run the DevKit, manage deployments, and stay focused on the application instead of the plumbing.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
