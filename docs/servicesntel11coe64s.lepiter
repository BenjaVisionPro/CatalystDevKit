				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Services are where application behaviour lives. Runtime hosts them, starts them, routes work for them, and gives them explicit capability access."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
