				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Codec receives complete bytes from transport, validates the message envelope and schema, then produces a message with type, version, fields, stream metadata, and delivery metadata. Outbound messages travel the same path in reverse."
			},
