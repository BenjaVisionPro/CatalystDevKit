				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Catalyst Groups\n\nGroups, teams, cohorts, and shared ownership models. Use it when users need to act together rather than alone.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
