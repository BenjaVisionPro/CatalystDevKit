				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "dK/f+TVoRVeLL3uqWdgDqQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "In-flight state lives in orchestration-private CRReconciliationState. Completion only happens when topology evidence matches intent."
			},
