				"uid": {
					"__type": "uid",
					"uidString": "h9DFJtmbTba5TMPUNX4c6A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Each tick observes snapshot truth in canonical order, ages in-flight intents, plans deterministically from config plus snapshot plus state, emits intents by scheduling work, and confirms completion from later evidence."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
