				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Orchestration is Runtime\u2019s reconciliation loop. It observes, plans, schedules, and confirms completion from later topology evidence."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
