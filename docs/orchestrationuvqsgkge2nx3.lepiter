				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Ue2VbDQtQgCZSWyHUuzY7Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It avoids blocking waits inside reconcile steps and work units."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
