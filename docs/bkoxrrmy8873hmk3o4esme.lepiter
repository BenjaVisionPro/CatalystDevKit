				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "BVCP is the default Catalyst protocol design for timely, observable, mixed-reliability communication."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
