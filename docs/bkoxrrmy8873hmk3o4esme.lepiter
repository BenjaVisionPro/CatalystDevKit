				},
				"uid": {
					"__type": "uid",
					"uidString": "nJuzeYTJGmSFXzBr4yyNCA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is BVCP"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "+n0JlWmeS377T9D/fQRR3A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "BVCP, the BenjaVision Catalyst Protocol, is the exemplar protocol built with Catalyst Connect. It is designed for realtime distributed systems that care about latency, relevance, and operational visibility."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "CyWDWOyH5iNpMvgWZeEd7g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "BC6CxvtIDrXMQzrUt3PXYw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It provides message-level relevance windows so expired data does not pollute the system."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Zpxt6ag2INsKdAoW8OlxIA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It supports mixed delivery intent: reliable, partial, and unreliable where each makes sense."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "b8HFJP/ry+aCrAOkdYq/Aw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives operations and developers telemetry for deadlines, jitter, drops, pacing, and routing decisions."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
