					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "+EXOs5izMsYuujvEbGvj1A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Roles can apply to people, personas, groups, bots, services, accounts, or runtime principals depending on context."
			},
