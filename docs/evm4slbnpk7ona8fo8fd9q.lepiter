					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "E7W4B37b18S48jJCqa5KgA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Roles often use the temporal-value pattern. A membership relationship may have a role value that moves from member to admin to owner. A romantic relationship may have role labels that change from boyfriend and girlfriend to husband and wife."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
