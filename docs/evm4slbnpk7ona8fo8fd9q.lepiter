				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Roles describe what a person, persona, group, or actor means inside a relationship or context."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
