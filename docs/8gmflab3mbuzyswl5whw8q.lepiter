					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "h5QRCf4z0InOq6s/O4pUqg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Hierarchy should express real structure, not just convenient storage."
			},
