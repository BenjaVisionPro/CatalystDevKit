				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A hierarchy is a relationship between groups. It may represent parent and child organisations, departments, squads, alliances, or nested communities."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
