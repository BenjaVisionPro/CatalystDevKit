					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "vv4OU9pPTYWxbgkJc96lzQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Is this what you are looking for?\n\nUse this component when its domain is part of the application, not just an implementation detail.\n\nIf the project only needs a quick one-off integration, this may not be the right layer yet. If the concept will become part of the product language, it probably is.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
