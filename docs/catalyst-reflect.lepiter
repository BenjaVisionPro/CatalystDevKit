				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Catalyst Reflect\n\nInspection, reflection, and understanding tools for Catalyst systems. Use it when you need the project to explain itself clearly.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
