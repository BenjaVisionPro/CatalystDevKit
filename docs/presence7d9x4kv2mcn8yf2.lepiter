				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "8puC35M1Ty+IShskxN7eLg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence is not a green dot. It is the work Catalyst does to make people feel present with each other across distance, devices, simulations, and runtime boundaries."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "ISkWPAYBT1ydvCJQTLfK3w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Presence"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "m6oEcBHtQNyIsv2QSEqdpw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence is a Catalyst Connect concept for shared social experience. It includes voice capture, cleanup, routing, audience selection, spatial mixing, environmental reverberation, echo, filtering, translation, and the presentation choices that make communication feel natural in context."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "VCnzYAu0TH+ILwnvayFTjg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A person may speak once, but each listener may hear a version shaped for their audience, position, environment, language, accessibility needs, and trust boundaries."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "uCzufd78S3idOjT8Svy+Cg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "OJTzUacNS0itgV5PXJT5hw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It makes realtime communication feel like people are actually together, not just sending audio packets at each other."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "pp0xIQbrRseF4SDT23M+fg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It lets the system clean and shape raw voice before distributing it to the people who should hear it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "LEH/Pq2rT3W9jrBeYVSwuw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives applications room for spatial audio, environmental acoustics, voice filtering, translation, and audience-specific presentation without confusing those concerns with identity or sessions."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "pDX/Nss3Q9Oy5OECWVYBqw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Gx69nQ6QSxWlsFFnXlLr7w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst People can provide identity, persona, and session context. Catalyst Connect uses that context with endpoint and environment data to decide who receives communication and how it should be presented."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "UXoBncVYS+WusKm6QSUp4Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence may include transport, routing, voice processing, spatialisation, translation, and rendering. The exact experience belongs to the endpoint and application, but Connect gives it a consistent conceptual home."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
