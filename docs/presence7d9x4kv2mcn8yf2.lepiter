				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Presence is the designed feeling of being together in a shared Catalyst environment."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
