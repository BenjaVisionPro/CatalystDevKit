					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T00:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "umqeyHjHSpyx+/+6TD9BRg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Presence"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
