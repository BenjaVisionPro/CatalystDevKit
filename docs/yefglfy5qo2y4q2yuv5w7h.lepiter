				},
				"uid": {
					"__type": "uid",
					"uidString": "SMOmqgL1854g0XicMi9LIA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Accounts connect to people or actors through relationships. The relationship can record holder, operator, owner, delegate, service identity, authority, and history over time."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
