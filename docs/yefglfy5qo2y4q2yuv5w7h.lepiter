					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "CI7jreaZcwsGFAomLCeIwg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Contextual Accounts explains why account modelling belongs to the context that gives the account meaning."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "ltevXyMm5VLh/CrCuhh/Zw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Contextual Accounts"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "d38XD8qxEk8M4BUO2GVd1A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "An account is a contextual access, ownership, value, or service container. It only makes sense inside the system that defines it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "Fns2KQl8+JZrhkzHNmR+iw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A person may have a Catalyst account, game accounts, currency accounts, store accounts, and service accounts. Those are related to the person, but they are not the person."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "da8tDdM1xS8BD9zbciLwag=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "3TYUjUymdaVWEuA6cbJanw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It avoids building one vague global Account object that tries to mean everything."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "FOg07HkmyeF03+l9bawqng=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It lets each component own the account shape it needs while Catalyst People provides the relationship back to the person."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
