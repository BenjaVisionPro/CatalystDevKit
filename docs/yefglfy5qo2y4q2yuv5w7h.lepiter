				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Accounts belong to a context: a Catalyst account, game account, currency account, or service account is not the person."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
