				"uid": {
					"__type": "uid",
					"uidString": "IZzMT/ISQjdNm6PT8KYYBg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "1v5ob9nXFz8+uYor+fI8sA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Each account type belongs to its component or application context. Catalyst People can relate a Person to that account using a relationship with history and meaning."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
