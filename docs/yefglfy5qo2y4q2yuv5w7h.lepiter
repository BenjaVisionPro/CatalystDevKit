				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Accounts belong to a context; they are not people and they are not universal identity."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
