				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "ZQ9VQHpCDGi9+1yyP7peuQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A person may have a verified identity, a public game persona, and several contextual accounts without those becoming the same object."
			},
