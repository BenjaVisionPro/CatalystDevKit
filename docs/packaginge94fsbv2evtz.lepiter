				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Runtime packaging keeps domain meaning in Core and platform mechanics in platform packages."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
