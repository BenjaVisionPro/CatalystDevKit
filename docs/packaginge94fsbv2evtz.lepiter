					"uidString": "lXMZ6/XERUG4dVGXRPRWOg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T12:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "/8qIRVRdQoG/DQ+YNNSr6A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Core packages define the runtime model. Platform packages implement host/worker mechanics, debug capture, and environment-specific support. UI, examples, and tests sit beside those packages without becoming runtime meaning."
			},
