				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Canonical package groups include BVC-Runtime-Configuration, BVC-Runtime-Kernel-Core, BVC-Runtime-Kernel-Pharo, BVC-Runtime-Kernel-GemStone, BVC-Runtime-Worker-Core, BVC-Runtime-Worker-Pharo, BVC-Runtime-Worker-GemStone, BVC-Runtime-Services, BVC-Runtime-Announcements, BVC-Runtime-UI, BVC-Runtime-Examples, and BVC-Runtime-Tests-*."
			},
