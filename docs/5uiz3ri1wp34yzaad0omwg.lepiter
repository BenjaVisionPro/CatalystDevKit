				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst People models real humans, their identities, and the relationships that give an application social meaning."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
