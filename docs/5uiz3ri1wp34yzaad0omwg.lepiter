				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "mU68HOVjl6Wr6RV6JDnJ5A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Start with {{gtPage:People and Identity|db=731asfxqhyhdr96k6wo9yxnzv}} for the basic human identity model, then read {{gtPage:Relationships|db=731asfxqhyhdr96k6wo9yxnzv}} for the time-based relationship model."
			},
			{
				"__type": "textSnippet",
				"children": {
