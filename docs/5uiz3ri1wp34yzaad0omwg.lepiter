					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "hKAj8HixUn0uQLis0qZ2Fw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Notes"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "rxYixDfqmwlPMrBROOrs6A=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Do not use Person as a synonym for account. Do not use Person for bots. Do not flatten personas, roles, and relationships into a single user record unless you want a tiny identity swamp wearing a fake moustache."
			}
		]
	},
	"createEmail": {
		"__type": "email",
