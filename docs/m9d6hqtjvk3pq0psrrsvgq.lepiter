				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "`bvc devkit` builds the DevKit if needed, refreshes GemStone connectors, then launches it."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "I0tQn4ohSFKFBr81yAnRDw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The connector file is written to `devkit/pharo-local/lepiter/gt4gemstone.properties` by default, based on configured deployments."
			},
