				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "DevKit Development is where you shape a Catalyst project before promoting work into a deployment workflow."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
