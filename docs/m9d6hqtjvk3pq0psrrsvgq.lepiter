				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "sBAdvsP5TjqL5WvQ2mUwNw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is DevKit Development"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "vN2sgyBqT4iMiG++KSpwtQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "DevKit Development is a project-local Glamorous Toolkit install prepared by bvc. It loads the configured project build scripts, refreshes GemStone connectors, and gives you the inspection tools needed to understand what the system is doing."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "NCTLtJ1CTPm73qm+qbUXlg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "LplitTVuT4iwXFRCL9RYEg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives every project a repeatable development image. It avoids manual GT setup. It keeps GemStone connectors current. It gives developers a fast place to inspect, test, debug, and evolve the system without confusing that workflow with production deployment."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
