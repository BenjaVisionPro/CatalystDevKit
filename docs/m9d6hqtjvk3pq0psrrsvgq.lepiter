				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The DevKit is where you inspect, explore, load, debug, and shape a Catalyst project."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
