					"uidString": "PePnVVDZQwirox/s7r6DxA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
