					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "VarWrQuwSqK9CHeHB9VCqg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "`bvc devkit` builds the DevKit if needed, refreshes deployment connectors, then launches Glamorous Toolkit. The DevKit is also able to run the Catalyst runtime standalone, but that deployment role is documented separately as DevKit Deployment."
			},
