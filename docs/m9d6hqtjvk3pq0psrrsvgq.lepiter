				"uid": {
					"__type": "uid",
					"uidString": "t0iZql4dSK+t/m+2UxREvw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is DevKit"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "lnk1Sfb2R1a3ekfBMc3T3g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The DevKit is a project-local Glamorous Toolkit install prepared by bvc. It loads the configured project build scripts and knows about available GemStone deployments."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "M9ufjag6TfygjFJ7OBUH3g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "K/NX/tFjRX6Pd7L38Jscpw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It gives the project a repeatable tool image. It avoids manual GT setup. It keeps GemStone connectors current. It makes the development environment something the project can recreate."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
