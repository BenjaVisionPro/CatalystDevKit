				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-19T10:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "1nZS4GogEj0LEHqi5Rm/1g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Relationships can connect people, groups, ideas, ideals, services, accounts, projects, places, resources, and other domain concepts."
			},
			{
				"__type": "textSnippet",
				"children": {
