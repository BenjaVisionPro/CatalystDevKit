				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Relationships explains how Catalyst People models meaningful connections without flattening them into a single current edge."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
