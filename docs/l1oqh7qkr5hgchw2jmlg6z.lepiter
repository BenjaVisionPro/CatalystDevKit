				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A relationship has identity, participants, context, and aspect timelines."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
