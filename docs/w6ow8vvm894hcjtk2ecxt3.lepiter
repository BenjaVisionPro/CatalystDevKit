					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-16T15:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "PYabcLDViEV1S25Z//Uyrw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Core events include accept, connected, TLS ready, readable ready, writable ready, peer closed, error, timeout, and config updated."
			},
