				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Groups and Collective Identity"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
