				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "A group is a collective identity. It may represent a team, guild, company, household, project, party, crew, organisation, or community."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
