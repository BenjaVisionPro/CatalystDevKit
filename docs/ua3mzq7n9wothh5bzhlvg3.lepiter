					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "u4wBRpBZNGIfzrjBfiNMiw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Groups can have names, descriptions, visibility, branding, owners, resources, and relationships to other concepts."
			},
