				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "BVCP over UDP adds datagram-oriented transport while keeping the same slice boundaries."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
