				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "6pCYhro5QIeedXTOfsAhUQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "GemStone is the Smalltalk object database and application server used by Catalyst deployments."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
