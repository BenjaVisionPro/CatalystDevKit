					"uidString": "h4ttY/k+QU2x1WbH04Y8iQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-15T09:00:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "L5ksVM8LT8yXpibYXBvCHg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It keeps authoritative state on the server. It supports long-lived object models. It gives deployments a transactional runtime. It lets Catalyst systems move beyond a local development deployment into a production runtime."
			},
