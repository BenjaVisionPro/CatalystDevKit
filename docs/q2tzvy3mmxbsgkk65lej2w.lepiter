					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "IuWxd33FQ+O2jjUDz0LTpw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "MTAOQw6bRXSfrDoSW14NXg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It keeps authoritative state on the server. It supports long-lived object models. It gives deployments a transactional runtime. It lets Catalyst build systems that are more than a client-side image."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
