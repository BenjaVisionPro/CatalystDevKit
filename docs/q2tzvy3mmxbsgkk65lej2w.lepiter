					"uidString": "9airZLPlQFWVpG292W5AcA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "GemStone is the Smalltalk object database and application server used by Catalyst production deployments."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
