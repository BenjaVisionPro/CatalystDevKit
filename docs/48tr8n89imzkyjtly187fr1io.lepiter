						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-10-18T15:58:46.870625+11:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
