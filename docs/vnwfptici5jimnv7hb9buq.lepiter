				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Catalyst projects use layered defaults, so simple projects stay simple and advanced projects can override only what they need."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
