				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# Project Configuration"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
