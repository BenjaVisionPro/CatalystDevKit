				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "vPmqHhrPQxGQEykkJGiu4g=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Project configuration is intentionally boring. A new project starts with a small config file and inherits the rest from the toolkit."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "9YmfhoqqRcCtbVZAGRDW7w=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What is Project Configuration"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "EcqeBKg1SOy0AiscHniQtQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Project Configuration is the set of defaults bvc uses to decide where projects, deployments, DevKit builds, Pharo images, and build scripts live."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "WumGjV2MRSG4DYNav1c0zA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What problems it solves"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "y/EBhcxyT+miDk5Zr82cxA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "It keeps new projects lightweight. It lets a project override only the values it cares about. It keeps toolkit defaults separate from project choices. It lets environment variables override everything when automation needs control."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "mb1D5ODjTdy5CPwQT84ZOQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## How it works"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "RkSqjcLXRKqhwjeWLGDfTA=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "Configuration is layered from highest priority to lowest: environment variables, project config, toolkit config, then hard-coded safety defaults."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "xzK2EvrBQ72243EusMjl/Q=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "The project config root defaults to `config`. The live project defaults file is `config/bvc/bvc_defaults`."
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T16:30:00+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "vK/9A+wnQ9eNuAqfjm7hEg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "`BVC_CONF_DIR` only selects the project config root. It does not move the toolkit config root. Toolkit defaults always come from the bvc repository's own `config` directory."
			},
