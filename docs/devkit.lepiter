				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "# DevKit\n\nThe DevKit is the Glamorous Toolkit environment for working with Catalyst projects.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "VgbSZshCRCGSbTZ41Sz3xw=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Launch\n\n```sh\nbvc devkit\n```\n\nThis command is intentionally high level. It builds the DevKit if needed, refreshes GemStone connectors, then launches it.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "69Hu0c8STeOba1PTc7riDg=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## What it prepares\n\nThe DevKit build uses the configured project sets and GT build scripts.\n\nThe important config values are:\n\n```sh\nGT_INSTALL_DIR\nGT_APP_NAME\nGT_BUILD_SCRIPTS_DIR\nPROJECTS_ROOT\n```\n\nMost projects should not need to touch these.\n"
			},
			{
				"__type": "textSnippet",
				"children": {
					"__type": "snippets",
					"items": []
				},
				"createEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"createTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"editEmail": {
					"__type": "email",
					"emailString": "<unknown>"
				},
				"editTime": {
					"__type": "time",
					"time": {
						"__type": "dateAndTime",
						"dateAndTimeString": "2026-05-14T14:00:07.115881+10:00"
					}
				},
				"uid": {
					"__type": "uid",
					"uidString": "mR6tII+dQ7GVjmRkTZFcoQ=="
				},
				"paragraphStyle": {
					"__type": "textStyle"
				},
				"string": "## Connectors\n\nThe DevKit gets a `gt4gemstone.properties` file containing one connector for each registered deployment.\n\nThat means a deployment does not need to be running to appear in the DevKit. It only needs to be registered.\n"
			}
		]
	},
